{
  "_readme": "Copy to config/mcp-config.json and adjust. Only servers listed here can be started. ${VAR} in args is read from backend env. Entries with verify:true are archived/community packages - confirm the package and flags before use.",
  "mcpServers": {
    "filesystem": { "name": "Filesystem MCP", "category": "Files", "description": "Read, write and list files inside ONE allowlisted directory (MCP_FS_ALLOWED_DIR, default ./sandbox).", "auth": "None", "license": "Open source (MIT)", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "${MCP_FS_ALLOWED_DIR}"] },
    "git": { "name": "Git MCP", "category": "Developer", "description": "Inspect and operate on one Git repository (MCP_GIT_REPO).", "auth": "None", "license": "Open source (MIT)", "command": "uvx", "args": ["mcp-server-git", "--repository", "${MCP_GIT_REPO}"], "note": "Requires uv (Python)." },
    "fetch": { "name": "Fetch MCP", "category": "Web", "description": "Fetch a URL and convert it to markdown for LLMs.", "auth": "None", "license": "Open source (MIT)", "command": "uvx", "args": ["mcp-server-fetch"], "note": "Requires uv (Python)." },
    "memory": { "name": "Memory MCP", "category": "AI", "description": "Knowledge-graph based persistent memory.", "auth": "None", "license": "Open source (MIT)", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-memory"] },
    "sequential-thinking": { "name": "Sequential Thinking MCP", "category": "AI", "description": "Structured, step-by-step problem solving tool.", "auth": "None", "license": "Open source (MIT)", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"] },
    "time": { "name": "Time MCP", "category": "Utility", "description": "Current time and timezone conversion.", "auth": "None", "license": "Open source (MIT)", "command": "uvx", "args": ["mcp-server-time"], "note": "Requires uv (Python)." },
    "github": { "name": "GitHub MCP", "category": "Developer", "description": "GitHub's official remote MCP server (repos, issues, PRs).", "auth": "Personal access token", "license": "Open source server; GitHub account required", "url": "https://api.githubcopilot.com/mcp/", "tokenEnv": "GITHUB_PERSONAL_ACCESS_TOKEN", "verify": true },
    "gitlab": { "name": "GitLab MCP", "category": "Developer", "description": "GitLab projects, issues and merge requests.", "auth": "Personal access token", "license": "Open source (archived reference server)", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-gitlab"], "env": ["GITLAB_PERSONAL_ACCESS_TOKEN", "GITLAB_API_URL"], "verify": true },
    "postgres": { "name": "PostgreSQL MCP", "category": "Database", "description": "Read-only SQL access to a PostgreSQL database.", "auth": "Connection string", "license": "Open source (archived reference server)", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-postgres", "${POSTGRES_URL}"], "verify": true },
    "sqlite": { "name": "SQLite MCP", "category": "Database", "description": "Query a local SQLite database file.", "auth": "None", "license": "Open source (archived reference server)", "command": "uvx", "args": ["mcp-server-sqlite", "--db-path", "${SQLITE_DB_PATH}"], "verify": true },
    "mysql": { "name": "MySQL MCP", "category": "Database", "description": "Community MySQL server.", "auth": "DB credentials", "license": "Open source (community)", "command": "npx", "args": ["-y", "@benborla29/mcp-server-mysql"], "env": ["MYSQL_HOST", "MYSQL_PORT", "MYSQL_USER", "MYSQL_PASS", "MYSQL_DB"], "verify": true },
    "mongodb": { "name": "MongoDB MCP", "category": "Database", "description": "MongoDB's official MCP server.", "auth": "Connection string", "license": "Open source", "command": "npx", "args": ["-y", "mongodb-mcp-server", "--readOnly"], "env": ["MDB_MCP_CONNECTION_STRING"], "verify": true },
    "redis": { "name": "Redis MCP", "category": "Database", "description": "Redis official MCP server.", "auth": "Redis URL", "license": "Open source", "command": "uvx", "args": ["--from", "redis-mcp-server@latest", "redis-mcp-server", "--url", "${REDIS_URL}"], "verify": true },
    "playwright": { "name": "Playwright MCP", "category": "Browser", "description": "Browser automation via accessibility snapshots.", "auth": "None", "license": "Open source (Apache-2.0)", "command": "npx", "args": ["@playwright/mcp@latest", "--headless"] },
    "puppeteer": { "name": "Puppeteer MCP", "category": "Browser", "description": "Browser automation with Puppeteer.", "auth": "None", "license": "Open source (archived reference server)", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-puppeteer"], "verify": true },
    "docker": { "name": "Docker MCP", "category": "DevOps", "description": "Community server to manage containers. Powerful: only enable locally.", "auth": "Local Docker socket", "license": "Open source (community)", "command": "uvx", "args": ["docker-mcp"], "verify": true },
    "kubernetes": { "name": "Kubernetes MCP", "category": "DevOps", "description": "Community server using your kubeconfig. Powerful: use a restricted context.", "auth": "kubeconfig", "license": "Open source (community)", "command": "npx", "args": ["-y", "mcp-server-kubernetes"], "verify": true },
    "slack": { "name": "Slack MCP", "category": "Productivity", "description": "Read and post to Slack channels.", "auth": "Bot token", "license": "Open source (archived reference server)", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-slack"], "env": ["SLACK_BOT_TOKEN", "SLACK_TEAM_ID"], "verify": true },
    "notion": { "name": "Notion MCP", "category": "Productivity", "description": "Notion's official MCP server.", "auth": "Integration token", "license": "Open source; Notion account required", "command": "npx", "args": ["-y", "@notionhq/notion-mcp-server"], "env": ["NOTION_TOKEN"], "verify": true },
    "linear": { "name": "Linear MCP", "category": "Productivity", "description": "Linear's hosted MCP via the mcp-remote bridge (OAuth in browser).", "auth": "OAuth / Linear account", "license": "Hosted service; Linear account required", "command": "npx", "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"], "verify": true }
  }
}
